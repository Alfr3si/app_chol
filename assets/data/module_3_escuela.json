  "muestras_sintacticas": [
    {
      "espanol": "Yo soy pescador",
      "chol": "Joñon xlukbäloň"
    },
    {
      "espanol": "Ella es maestra",
      "chol": "Ili xpäsjuň"
    },
    {
      "espanol": "Nosotros somos campesinos",
      "chol": "Joñoñlon xcholejeloñloň"
    },
    {
      "espanol": "Ellos son curanderos",
      "chol": "Ixä xts'ako'"
    },
    {
      "espanol": "Hay muchas sillas",
      "chol": "ka bä añ buchli bäl"
    },
    {
      "espanol": "Las sillas son amarillas",
      "chol": "K'änk'äîn li buchli bäl"
    },
    {
      "espanol": "Los maestros enseñan",
      "chol": "Li xpäsjuño muk'o' tyi käntyisaj"
    },
    {
      "espanol": "Mi mamá cocina en el fogón",
      "chol": "Jiñi kmam ipäty ibäñik' tyi k'ajk"
    },
    {
      "espanol": "Mi papá trabaja en la milpa",
      "chol": "Jiñi kpap muk tyi toñel tyi cholel"
    },
    {
      "espanol": "Esas niñas son bonitas",
      "chol": "Ixä saj xk'alälo' ñoj ilekaxo'"
    },
    {
      "espanol": "Mis hermanas barren la casa",
      "chol": "Jiñi kchicho' imisuño' li otyoty"
    },
    {
      "espanol": "Mi hermano sale a cazar en la noche",
      "chol": "Jiñi kermañu' ilok'el majlel tyi xäñtye'el tyi ik'añ"
    },
    {
      "espanol": "El perro caza tepezcuintle",
      "chol": "Ili ts'i' ichuke' jalaw"
    },
    {
      "espanol": "El libro está debajo de la silla",
      "chol": "Li dibru ya'añ tyi iye bal li buchli bäl"
    },
    {
      "espanol": "El cuaderno está al lado de las tijeras",
      "chol": "Jiñi jun ya'an tyi ity'ej tyi tyexelex"
    },
    {
      "espanol": "¿Dónde están los niños?",
      "chol": "¿Ba'ki año li alp'eñalo'?"
    },
    {
      "espanol": "Los niños juegan en el patio",
      "chol": "Jiñi alp'eñalo' muk'o' tyi tyi Paty otyoty"
