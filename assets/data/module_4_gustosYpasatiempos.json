  "muestras_sintacticas": [
    {
      "espanol": "Me gusta el pozol",
      "chol": "Kmulañ li sa'"
    },
    {
      "espanol": "Me encanta la yuca",
      "chol": "Kmulaň li ts'ijň"
    },
    {
      "espanol": "No me gusta el chayote",
      "chol": "Ma'aîñ kmulañ li ch'ijch'um"
    },
    {
      "espanol": "¿Te gusta el mole?",
      "chol": "¿a mulaň li mole?"
    },
    {
      "espanol": "¿Cuál es tu comida favorita?",
      "chol": "¿ba'kibä bäñäk' a weñ mulaň?"
    },
    {
      "espanol": "¿Cuántos círculos hay?",
      "chol": "¿jayp'eki selekňabä añ?"
    },
    {
      "espanol": "Hay seis círculos",
      "chol": "Añ wäkp'ej selekñabä"
    },
    {
      "espanol": "Hay once naranjas",
      "chol": "Añ junlujump'ej alaxax"
    },
    {
      "espanol": "¿Qué día es hoy?",
      "chol": "¿chuki tyi k'in wäleli?"
    },
    {
      "espanol": "Hoy es 20 de noviembre",
      "chol": "Junk'al k'in wäleli"
    },
    {
      "espanol": "Yo camino a la milpa",
      "chol": "Joñoň muk'oň tyi xämbal tyi cholel"
    },
    {
      "espanol": "Los niños nadan en el río",
      "chol": "Jiñi alp'eñalo' muk'o' tyi ñuxejel tyi kolem ja'"
    },
    {
      "espanol": "Mis hermanos corren por el campo",
      "chol": "Jiñi kermañujo' muk'o' tyi ajñel tyi jami"
    }
